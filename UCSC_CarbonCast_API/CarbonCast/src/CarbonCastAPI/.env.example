# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=carboncast
DB_USER=carboncast
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (broker for Celery on DB 0, cache on DB 1)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Auth toggle (set to True to require session/basic auth)
REQUIRES_AUTH=False

# EIA API (https://www.eia.gov/opendata/)
EIA_API_KEY=

# ENTSO-E Transparency Platform (https://transparency.entsoe.eu/)
ENTSOE_API_TOKEN=
# Optional: override entsoe-py endpoint (changed November 2025)
# ENTSOE_ENDPOINT_URL=https://external-api.tp.entsoe.eu/api

# RDA Automation Tool integration
# NOTE: the tool authenticates via a rdams_token.txt file in its working
# directory (src/python/), not an env var.
# Where the tool writes downloads (its base_download_dir):
RDA_DOWNLOAD_DIR=
# Where Django writes weekly .ctl files for the tool to pick up:
RDA_CONTROL_FILES_DIR=
# The tool's config (region bounding boxes): .../config/automation_config.json
RDA_CONFIG_PATH=
# The tool's state file (pipeline dashboard reads request progress from it):
# .../src/python/batch_automation_state.json
RDA_STATE_FILE=
# Disk retention for ingested downloads (cleanup task):
RDA_CLEANUP_ENABLED=false
RDA_RETENTION_DAYS=14
# Optional: move instead of delete
# RDA_ARCHIVE_DIR=

# Database engine escape hatch: set to "sqlite" for user-space deployments
# without a Postgres server (DB_NAME then optionally points at the .sqlite3
# file). Default is postgres.
# DB_ENGINE=postgres
