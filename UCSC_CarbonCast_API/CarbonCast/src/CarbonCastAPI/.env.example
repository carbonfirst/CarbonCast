# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=carboncast
DB_USER=carboncast
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (broker for Celery on DB 0, cache on DB 1)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Auth toggle (set to True to require session/basic auth)
REQUIRES_AUTH=False

# EIA API (https://www.eia.gov/opendata/)
EIA_API_KEY=

# ENTSO-E Transparency Platform (https://transparency.entsoe.eu/)
ENTSOE_API_TOKEN=
# Optional: override entsoe-py endpoint (changed November 2025)
# ENTSOE_ENDPOINT_URL=https://external-api.tp.entsoe.eu/api

# RDA Automation Tool integration
RDA_TOKEN=
RDA_DOWNLOAD_DIR=
RDA_CONTROL_FILES_DIR=
RDA_CONFIG_PATH=
