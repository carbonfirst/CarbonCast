# =============================================================================
# CarbonCast Monorepo .gitignore
# -----------------------------------------------------------------------------
# This monorepo intentionally tracks ONLY source code, configuration, and docs.
# Large datasets, trained models, downloaded weather files, virtual envs, and
# build artifacts are kept LOCAL ONLY (see docs/05-data-and-large-files.md for
# why and how to regenerate / fetch them).
# =============================================================================

# -----------------------------------------------------------------------------
# Large data & model directories (KEEP LOCAL — do NOT commit)
# -----------------------------------------------------------------------------
**/data/
**/data_old (v2.1)/
**/data_old(v3.1)/
**/CI_forecast_data/
**/real_time/
**/saved_first_tier_models/
**/saved_second_tier_models/
**/downloaded_files/
**/weather_data/

# Large binary data formats
*.grib2
*.grib
*.tar
*.nc
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Keras / TensorFlow saved models
*.keras
*.pb
saved_model/

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
db.sqlite3

# -----------------------------------------------------------------------------
# Secrets & credentials (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
rdams_token.txt
**/rdams_token.txt
api_keys.txt
secrets.txt
tokens.txt
credentials.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Test / coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.hypothesis/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node / frontend
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# -----------------------------------------------------------------------------
# Logs & runtime state
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime state files (regenerated by the pipeline / automation tool)
*_state.json
queue_state.json
batch_automation_state.json
metrics_history.json
*_metrics.json
*_history.json

# Backups
*.bak
*.backup
*.backup_*
backups/

# -----------------------------------------------------------------------------
# OS / editor
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
