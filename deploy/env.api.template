# CarbonCast API environment — generated by deploy/bootstrap.sh
# Review before first start; restart supervisord programs after edits.

# Django
DJANGO_SECRET_KEY=__SECRET__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,carboncast.duckdns.org

# Database: "postgres" (needs DB_* below) or "sqlite" (file under src/CarbonCastAPI)
DB_ENGINE=__DB_ENGINE__
DB_NAME=carboncast
DB_USER=carboncast
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (broker DB 0, cache DB 1)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

REQUIRES_AUTH=False

# ── Credentials ───────────────────────────────────────────────────────
# EIA (https://www.eia.gov/opendata/) — US energy ingestion.
# Empty = the pipeline runs and the dashboard shows "Needs credential".
EIA_API_KEY=
# ENTSO-E (https://transparency.entsoe.eu/) — EU energy ingestion.
ENTSOE_API_TOKEN=

# ── RDA automation tool wiring (absolute paths) ───────────────────────
# NOTE: the tool itself authenticates via rdams_token.txt in its
# working directory (src/python/), not an env var.
RDA_DOWNLOAD_DIR=__REPO_ROOT__/UCSC_OSRE_CC_automation_tool/CarbonCast/src/python/downloaded_files
RDA_CONTROL_FILES_DIR=__REPO_ROOT__/UCSC_OSRE_CC_automation_tool/CarbonCast/src/python/control_files
RDA_CONFIG_PATH=__DEPLOY_HOME__/automation_config.json
RDA_STATE_FILE=__REPO_ROOT__/UCSC_OSRE_CC_automation_tool/CarbonCast/src/python/batch_automation_state.json

# Disk retention for ingested weather downloads
RDA_CLEANUP_ENABLED=true
RDA_RETENTION_DAYS=14

# Optional pipeline tuning
# PIPELINE_REGIONS=CISO,PJM        # restrict retraining; empty = all with data
# CARBONCAST_RUN_ML=false          # true needs saved models + CARBONCAST_CONFIG_FILE
CARBONCAST_ARTIFACT_DIR=__DEPLOY_HOME__/data/artifacts
