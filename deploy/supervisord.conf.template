; CarbonCast user-space process manager — generated by deploy/bootstrap.sh
; Start:  .venv-api/bin/supervisord -c <this file>
; Status: .venv-api/bin/supervisorctl -c <this file> status
; Logs:   __DEPLOY_HOME__/logs/*.log

[supervisord]
logfile=__DEPLOY_HOME__/logs/supervisord.log
pidfile=__DEPLOY_HOME__/run/supervisord.pid
childlogdir=__DEPLOY_HOME__/logs
nodaemon=false

[unix_http_server]
file=__DEPLOY_HOME__/run/supervisor.sock

[supervisorctl]
serverurl=unix://__DEPLOY_HOME__/run/supervisor.sock

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[program:redis]
command=__REDIS_CMD__ --port 6379 --dir __DEPLOY_HOME__/data --appendonly yes
priority=10
autorestart=true
stdout_logfile=__DEPLOY_HOME__/logs/redis.log
redirect_stderr=true

[program:api]
command=__REPO_ROOT__/.venv-api/bin/gunicorn CarbonCastAPI.wsgi:application --bind 0.0.0.0:8000 --workers 2 --timeout 120
directory=__API_SRC__
environment=PYTHONUNBUFFERED="1"
priority=20
autorestart=true
stdout_logfile=__DEPLOY_HOME__/logs/api.log
redirect_stderr=true

[program:celery-worker]
command=__REPO_ROOT__/.venv-api/bin/celery -A CarbonCastAPI worker -l info --concurrency 2
directory=__API_SRC__
environment=PYTHONUNBUFFERED="1"
priority=30
autorestart=true
stopwaitsecs=300
stdout_logfile=__DEPLOY_HOME__/logs/celery-worker.log
redirect_stderr=true

[program:celery-beat]
command=__REPO_ROOT__/.venv-api/bin/celery -A CarbonCastAPI beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler
directory=__API_SRC__
environment=PYTHONUNBUFFERED="1"
priority=40
autorestart=true
stdout_logfile=__DEPLOY_HOME__/logs/celery-beat.log
redirect_stderr=true

[program:rda-tool]
command=__REPO_ROOT__/.venv-tool/bin/python run_automation_loop.py --config __DEPLOY_HOME__/automation_config.json
directory=__TOOL_PY__
environment=PYTHONUNBUFFERED="1"
priority=50
autorestart=true
stopwaitsecs=120
stdout_logfile=__DEPLOY_HOME__/logs/rda-tool.log
redirect_stderr=true

[program:ui]
; serves the built SPA (npm run build first) with client-side routing fallback
command=npx --yes serve -s __UI_DIR__/dist -l 8001
priority=60
autorestart=true
stdout_logfile=__DEPLOY_HOME__/logs/ui.log
redirect_stderr=true

[group:carboncast]
programs=redis,api,celery-worker,celery-beat,rda-tool,ui
